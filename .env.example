# Copy this file to .env and fill in your values.
# Used by docker-compose.yml for local development only.
# Google sign-in is optional locally — the demo-login buttons work without it.
# Production env vars (Neon connection string, etc.) are set as Vercel
# project env vars; see README.md > Environment Variables.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
